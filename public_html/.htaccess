Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Satu alamat resmi: www diarahkan ke domain utama (hindari konten ganda di Google)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Paksa HTTPS di lingkungan produksi (lewati untuk localhost / IP lokal)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Blokir akses langsung ke file tersembunyi (.env, .git, .htaccess)
    RewriteRule "(^|/)\." - [F]
    # Folder internal tidak boleh terbuka dari web, apa pun letak foldernya di server
    RewriteRule ^(_private|app|vendor|database|storage|\.github)(/|$) - [F,L]

    # Teruskan seluruh URL bersih ke Front Controller index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Header Keamanan HTTP
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS tanpa includeSubDomains: subdomain portal dikelola terpisah
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Kompresi Gzip / Deflate untuk penghematan kuota data mobile
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript text/javascript application/json image/svg+xml font/woff2
</IfModule>

# Caching aset statis di browser
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    # CSS/JS dipanggil dengan ?v=<waktu ubah>, jadi aman disimpan lama: berkas baru = URL baru
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>


# Versi PHP untuk hosting cPanel (EasyApache). Ditulis di sini karena deploy menimpa .htaccess dan menghapus
# pengaturan MultiPHP Manager. Server LiteSpeed memakai akhiran ___lsphp. Ubah ea-php82 bila versi di server diganti. Diabaikan di lokal.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
