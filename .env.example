# Konfigurasi Website SMA Swadaya
# Simpan file .env ini di luar folder public_html pada shared hosting

APP_NAME="SMA Swadaya"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sma.swadaya.sch.id
PORTAL_URL=https://ujiansma.swadaya.sch.id
TIMEZONE=Asia/Jakarta

# Database (MySQL / MariaDB di Shared Hosting, atau sqlite untuk pengembangan lokal)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sma_swadaya
DB_USERNAME=root
DB_PASSWORD=
DB_FALLBACK_SQLITE=true

# Email SMTP (Kirim dari domain lembaga, bukan fungsi mail() bawaan)
# MAIL_HOST: server mail hosting asli SMA Swadaya (lihat cPanel > Email Accounts > Connect Devices), bukan subdomain yang diproksi Cloudflare
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=support@sma.swadaya.sch.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@sma.swadaya.sch.id
MAIL_FROM_NAME="SMA Swadaya"
MAIL_ADMIN_RECIPIENTS=support@sma.swadaya.sch.id

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Keamanan & Retensi
SESSION_LIFETIME_MINUTES=30
BUKTI_TOKEN_EXPIRE_DAYS=30
RETENTION_DAYS_INACTIVE=30
RATE_LIMIT_MAX_REGISTRATIONS_PER_HOUR=5

