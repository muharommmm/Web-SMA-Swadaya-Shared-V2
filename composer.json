{
    "name": "sma-swadaya/website",
    "description": "Website Resmi SMA Swadaya - PHP Native untuk Shared Hosting",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^5.0",
        "vlucas/phpdotenv": "^5.6",
        "ezyang/htmlpurifier": "^4.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

